rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function staffRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        in ['SUPER_ADMIN', 'FINANCE_MANAGER', 'CONTENT_EDITOR', 'SUPPORT_AGENT', 'READONLY_ANALYST'];
    }
    function isSuperAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN';
    }

    // User profiles. Users may create/read their own profile but can never
    // choose or change their own role, ban status or verification flags.
    match /users/{uid} {
      allow read: if isOwner(uid) || (signedIn() && staffRole());

      allow create: if isOwner(uid)
        && request.resource.data.role == 'USER'
        && request.resource.data.isBanned == false
        && request.resource.data.isEmailVerified == false
        && request.resource.data.mfaEnabled == false
        && request.resource.data.keys().hasOnly(
          ['id', 'email', 'name', 'role', 'isEmailVerified', 'mfaEnabled', 'avatarUrl',
           'isBanned', 'createdAt', 'updatedAt']);

      // Owners may only change their display fields.
      allow update: if (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'avatarUrl', 'updatedAt']))
        || isSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    // Everything else is closed until a feature is migrated with its own rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
