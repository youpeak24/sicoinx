# Base URL of the SI Coin API server (the Express app in apps/api).
# Accepts either the server origin or the full /api/v1 URL.
#
# - Physical phone / Expo Go: use your computer's LAN IP, e.g. http://192.168.1.20:5000
# - Android emulator:        http://10.0.2.2:5000
# - iOS simulator:           http://localhost:5000
# - Production:              https://api.your-domain.com   (HTTPS is required for release builds)
#
# In development the app falls back to the machine that is serving Metro
# (port 5000), so this is usually only needed for production builds.
EXPO_PUBLIC_API_URL=

# Firebase web config of project "sicoinx" (Firebase console > Project settings > Your apps > Web app).
# These are public client identifiers, the same values the website uses (VITE_FIREBASE_* in apps/web/.env).
# The app signs users in with Firebase Authentication, so these are required. For EAS builds, set them in
# eas.json ("env") or as EAS environment variables. Restart Metro with `npx expo start -c` after changing them.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Public website, used for the Terms, Privacy and FAQ links (optional).
EXPO_PUBLIC_WEB_URL=https://www.sicoinx.com
