# Firebase web app config (Firebase console -> Project settings -> Your apps).
# Copy to apps/web/.env for local dev, and add the same keys in Vercel project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- SEO (build-time, optional; set in Vercel project settings) ---------------
# Public base URL of the deployed API. When set, the build pre-renders every
# published announcement as a static page and lists it in sitemap.xml.
SEO_API_URL=
# Search Console / Webmaster ownership tokens (rendered as <meta> tags in every page).
SEO_GOOGLE_VERIFICATION=
SEO_BING_VERIFICATION=
SEO_YANDEX_VERIFICATION=
