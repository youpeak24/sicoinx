# ==============================================================
# SI Coin Ecosystem Platform — Environment Variables Guide
# ==============================================================

# Server Network Settings
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database Connection
# SQLite local development (default):
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://sicoin_user:securepassword@localhost:5432/sicoin_db?schema=public"

# Cryptographic Secrets (Must be random, >= 32 characters in production)
JWT_SECRET=super-secure-jwt-secret-key-si-coin-2026-production-min-32-chars
SESSION_SECRET=super-secure-session-secret-si-coin-2026-unique-hash
COOKIE_SECRET=super-secure-cookie-secret-si-coin-fintech-shield

# Initial Administrator Bootstrapping
INITIAL_ADMIN_EMAIL=admin@sicoin.org
INITIAL_ADMIN_PASSWORD=AdminSecurePass123!
INITIAL_ADMIN_NAME="Chief System Administrator"

# External Market Data Feed Keys (Optional)
PRICE_SOURCE_MODE=MANUAL
COINGECKO_API_KEY=""
COINCAP_API_KEY=""

# Email Service Configuration
# When MAIL_DEV_MODE=true, emails are captured in an internal preview buffer
# accessible via GET /api/v1/auth/dev-mailboxes for testing without real SMTP credentials.
MAIL_DEV_MODE=true
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="SI Coin Security <noreply@sicoin.org>"
