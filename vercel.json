{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "[ -d packages/shared ] || cd ../..; npm install",
  "buildCommand": "if [ -f scripts/vercel-build.sh ]; then sh scripts/vercel-build.sh; else sh ../../scripts/vercel-build.sh; fi",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-API-HOST.example.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://YOUR-API-HOST.example.com/uploads/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
